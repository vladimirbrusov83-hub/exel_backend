# From the service-account JSON key ("client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# From the same JSON ("private_key"). Keep the \n escaped and wrap in double quotes.
GOOGLE_PRIVATE_KEY=""
# The long id in the Sheet URL, between /d/ and /edit
SHEET_ID=
# Private per-client URL slugs. Generate with: openssl rand -hex 12
CLIENT_1_SLUG=
CLIENT_2_SLUG=
# Your own private coach page (/coach/<this>), for building next week. Generate the same way.
COACH_SLUG=
